# .env.example
# Copy this file to .env and replace the values with your actual API keys.

# ==========================================
# NVIDIA NIM CONFIGURATION (RECOMMENDED)
# ==========================================
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ==========================================
# GROQ CONFIGURATION (FALLBACK)
# ==========================================
# If you prefer to use Groq for faster inference, uncomment and configure below:
# GROQ_API_KEY="gsk_your-groq-api-key-here"
# NVIDIA_MODEL="llama-3.1-8b-instant"
# NVIDIA_BASE_URL="https://api.groq.com/openai/v1"
